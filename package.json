{
  "name": "arch-ai-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run tauri -w @arch/desktop -- dev",
    "build": "npm run tauri -w @arch/desktop -- build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "schema:export": "npm run schema:export -w @arch/domain",
    "check:rust": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:rust"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
