# Copy to .env (gitignored) and fill in. Loaded at app start and by the live tests; a variable
# already set in the environment always wins. Keys can instead be saved in the app's provider
# settings (Windows Credential Manager), which win over these.

# HHTECH (OpenAI-compatible gateway)
HHTECH_API_KEY=
# Optional server override [https://hhtechapi.com/v1]
HHTECH_BASE_URL=
# Optional (defaults in brackets)
# Comma-separated base ids that restrict and order the picker [the full built-in catalog]
HHTECH_IMAGE_MODEL=
# Size sent when no tier is chosen and without an aspect ratio, or auto [1024x1024]
HHTECH_IMAGE_SIZE=
# GPT quality when the Quality control is on Default: low | medium | high | auto [medium]
HHTECH_IMAGE_QUALITY=
# Chat model used by Enhance prompt [claude-sonnet-5]
HHTECH_CHAT_MODEL=
HHTECH_TIMEOUT_SECS=

# Development key fallbacks for the other providers
ARCH_STUDIO_GEMINI_API_KEY=
ARCH_STUDIO_OPENAI_API_KEY=

# Custom gateway (ADR-040): any other OpenAI-compatible gateway, e.g. BEAR. Leave empty to hide it.
GATEWAY_API_KEY=
# Required, e.g. https://api.example.com/v1
GATEWAY_BASE_URL=
# Required: comma-separated image model ids, offered in this order
GATEWAY_IMAGE_MODEL=
GATEWAY_IMAGE_SIZE=
GATEWAY_IMAGE_QUALITY=
# Optional: turns on "Enhance prompt" for this gateway
GATEWAY_CHAT_MODEL=
GATEWAY_TIMEOUT_SECS=

# Video providers (ADR-043). Keys can also go in the app's provider settings. Nothing is called
# until you press "Create video" and confirm the cost.
# Kling: ACCESS_KEY:SECRET_KEY from the Kling developer console
KLING_API_KEY=
KLING_VIDEO_MODEL=
KLING_BASE_URL=
# Veo (Gemini API): a Gemini API key works; GEMINI_API_KEY is also read
VEO_API_KEY=
VEO_VIDEO_MODEL=
VEO_BASE_URL=
# Seedance (BytePlus ModelArk); the model id may also be an endpoint id
ARK_API_KEY=
SEEDANCE_VIDEO_MODEL=
SEEDANCE_BASE_URL=
# Comfy Cloud: the API key plus a workflow exported with "Export (API)" (path to the .json)
COMFY_CLOUD_API_KEY=
COMFY_VIDEO_WORKFLOW=
COMFY_CLOUD_BASE_URL=
