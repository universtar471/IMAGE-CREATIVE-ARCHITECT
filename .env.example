# Copy to .env (gitignored) and fill in. Loaded at app start and by the live tests; a variable
# already set in the environment always wins. Keys can instead be saved in the app's provider
# settings (Windows Credential Manager), which win over these.

# HHTECH (OpenAI-compatible gateway)
HHTECH_API_KEY=
# Required, e.g. https://hhtechapi.com/v1
HHTECH_BASE_URL=
# Optional (defaults in brackets)
# Comma-separated base ids that restrict and order the picker [the full built-in catalog]
HHTECH_IMAGE_MODEL=
# Size sent when no tier is chosen and without an aspect ratio, or auto [1024x1024]
HHTECH_IMAGE_SIZE=
# GPT quality when the Quality control is on Default: low | medium | high | auto [medium]
HHTECH_IMAGE_QUALITY=
# Chat model used by Enhance prompt [claude-sonnet-5]
HHTECH_CHAT_MODEL=
HHTECH_TIMEOUT_SECS=

# Development key fallbacks for the other providers
ARCH_STUDIO_GEMINI_API_KEY=
ARCH_STUDIO_OPENAI_API_KEY=
